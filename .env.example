# Paste this whole file into GitHub secret STAGING_ENV (one secret, all values).

# Frontend (main domain)
NEXT_PUBLIC_SITE_URL=https://example.com

# WordPress API (wp subdomain -> public_html/wp)
NEXT_PUBLIC_WP_API_URL=https://wp.example.com/wp-json
NEXT_PUBLIC_WP_SITE_URL=https://wp.example.com
NEXT_PUBLIC_WP_THEME_PATH=

# FTP -> public_html (wp/ is never deleted)
STAGING_FTP_HOST=ftp.example.com
STAGING_FTP_USERNAME=
STAGING_FTP_PASSWORD=
STAGING_FTP_SERVER_DIR=/public_html/
STAGING_FTP_PORT=21
STAGING_FTP_PROTOCOL=ftps
