# Required — same three you use locally (production/staging URLs here)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_WP_API_URL=https://wp.example.com/wp-json
NEXT_PUBLIC_WP_SITE_URL=https://wp.example.com

# FTP — only needed in GitHub secret STAGING_ENV (not for local npm run dev)
STAGING_FTP_HOST=ftp.example.com
STAGING_FTP_USERNAME=
STAGING_FTP_PASSWORD=
STAGING_FTP_SERVER_DIR=/public_html/
STAGING_FTP_PORT=21
STAGING_FTP_PROTOCOL=ftps

# Optional — leave empty. Fallback theme image base only.
# NEXT_PUBLIC_WP_THEME_PATH=

# Not used anymore (static export, no /api/revalidate):
# REVALIDATE_SECRET=
# WP_FETCH_REVALIDATE=
